# Copy to .env. Never commit real keys.
ASR_API_KEY=
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
TTS_LANGUAGE=en
TTS_REGION=US
TTS_RATE=1.0
# Optional Android TTS package name. Empty means system default.
TTS_ENGINE=
# Maximum duration; recording can also be stopped early with Enter.
RECORD_SECONDS=120
HTTP_TIMEOUT=90
HISTORY_TURNS=6

# Empty uses persona.txt, falling back to persona.example.txt.
PERSONA_FILE=
# Automatic mode only: RMS amplitude threshold (1..32767).
VAD_THRESHOLD=600
# Pause duration that ends a sentence; increase for hesitant speech.
SILENCE_SECONDS=3
MIN_SPEECH_SECONDS=0.3
# Silence waits locally; no cloud request is sent.
LISTEN_TIMEOUT=30
# Delay after TTS completes, for Bluetooth playback latency.
PLAYBACK_COOLDOWN=0.8

# hybrid (Chinese local / English cloud), siliconflow, or android.
TTS_PROVIDER=hybrid
# Empty reuses ASR_API_KEY only for the official SiliconFlow endpoint.
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:diana
CLOUD_TTS_SPEED=1.0

# Package name of the installed Xiao Ya Android TTS engine.
TTS_ZH_ENGINE=

# Total local Android TTS call timeout, including playback (5..600 seconds).
TTS_TIMEOUT=180

WAKE_ENABLED=1

SLEEP_AFTER_SECONDS=60

# Local prerecorded synthesis / error notices; 0 disables.
AUDIO_PROMPTS=1

# Introduce features once on first conversation startup.
INTRO_ENABLED=1
